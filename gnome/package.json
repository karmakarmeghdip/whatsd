{
    "name": "whatsd-gnome",
    "description": "Native GNOME desktop client for the whatsd WhatsApp daemon.",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "gjsify": {
        "app": "gjs"
    },
    "scripts": {
        "check": "gjsify tsc --noEmit",
        "build": "gjsify build --app gjs src/index.ts --outfile dist/index.js",
        "start": "gjsify run dist/index.js",
        "dev": "gjsify build --app gjs src/index.ts --outfile dist/index.js && gjsify run dist/index.js",
        "lint:blp": "blueprint-compiler lint src/window.blp"
    },
    "devDependencies": {
        "@girs/adw-1": "^4.1.0",
        "@girs/gdk-4.0": "^4.1.0",
        "@girs/gio-2.0": "^4.1.0",
        "@girs/gjs": "^4.1.0",
        "@girs/gobject-2.0": "^4.1.0",
        "@girs/gtk-4.0": "^4.1.0",
        "@gjsify/cli": "^0.20.0",
        "@gjsify/vite-plugin-blueprint": "^0.20.0",
        "@types/node": "^25.9.2",
        "typescript": "^6.0.3"
    }
}
